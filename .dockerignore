# SecureCloud Root Docker Build Context Ignore Rules

# Version control metadata
.git
.gitignore
.gitattributes

# Local IDE, editor, and OS metadata
.DS_Store
.vscode
.idea
.antigravity

# Local build artifacts and caches
build/
build-*/
cmake-build-*/
.cache/
vcpkg_installed/

# Documentation, specifications, and benchmarks (not required for binary compilation)
docs/
specs/
benchmarks/
*.md

# Local environment configuration, credentials, logs, and TLS material
.env*
*.log
deploy/dev-pki/
*.pem
*.crt
*.key
*.p12
*.pfx

