# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF line endings on scripts, configs, schemas, and source code
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.proto text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows batch and PowerShell scripts preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
