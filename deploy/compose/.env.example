# SecureCloud Development Environment Configuration Template
# DO NOT commit active .env or production credentials to version control.
# Copy this file to deploy/compose/.env for local development customization.

# ==============================================================================
# Microservice Runtime & Network Configuration (SC-012)
# ==============================================================================
SECURECLOUD_GRPC_HOST=0.0.0.0
SECURECLOUD_GATEWAY_GRPC_PORT=50051
SECURECLOUD_AUTH_GRPC_PORT=50052
SECURECLOUD_MESSAGING_GRPC_PORT=50053
SECURECLOUD_FILES_GRPC_PORT=50054
SECURECLOUD_AUDIT_GRPC_PORT=50055

# Host loopback publishing ports (127.0.0.1)
GATEWAY_HTTPS_HOST_PORT=8443
GATEWAY_HTTP_HOST_PORT=8080
GATEWAY_HOST_PORT=50051
AUTH_HOST_PORT=50052
MESSAGING_HOST_PORT=50053
FILES_HOST_PORT=50054
AUDIT_HOST_PORT=50055

# Gateway HTTP/HTTPS Listener
SECURECLOUD_GATEWAY_HTTP_HOST=0.0.0.0
SECURECLOUD_GATEWAY_HTTP_PORT=8080
SECURECLOUD_GATEWAY_HTTPS_PORT=8443
SECURECLOUD_GATEWAY_TLS_ENABLED=true

# Gateway Peer Probe Configuration
SECURECLOUD_GATEWAY_PEER_PROBE_TARGET=auth:50052
SECURECLOUD_GATEWAY_PEER_PROBE_NAME=auth

# Audit producer runtime settings (business services remain independent of Audit startup)
SECURECLOUD_GATEWAY_AUDIT_MODE=spool
SECURECLOUD_GATEWAY_AUDIT_MAX_SPOOL_BYTES=1073741824
SECURECLOUD_GATEWAY_AUDIT_MAX_SPOOL_RECORDS=100000
SECURECLOUD_AUTH_INSTANCE_ID=auth-1
SECURECLOUD_AUTH_OUTBOX_RELAY_ENABLED=true
SECURECLOUD_MESSAGING_AUDIT_INSTANCE_ID=messaging-1
SECURECLOUD_MESSAGING_AUDIT_RELAY_ENABLED=true
SECURECLOUD_MESSAGING_AUDIT_WORKER_THREADS=4
SECURECLOUD_MESSAGING_AUDIT_BATCH_SIZE=100
SECURECLOUD_MESSAGING_AUDIT_MAX_RETRIES=5
SECURECLOUD_MESSAGING_AUDIT_ACTIVE_POLL_INTERVAL_MS=50
SECURECLOUD_MESSAGING_AUDIT_IDLE_POLL_INTERVAL_MS=500
SECURECLOUD_MESSAGING_AUDIT_LEASE_DURATION_SEC=30
SECURECLOUD_MESSAGING_AUDIT_RPC_TIMEOUT_MS=5000
SECURECLOUD_FILES_INSTANCE_ID=files-1
SECURECLOUD_FILES_AUDIT_RELAY_ENABLED=true

# ==============================================================================
# PostgreSQL 17 Development Configuration
# ==============================================================================
# Invariant: SecureCloud binds to host port 5433 (host port 5432 is reserved for host PostgreSQL 14)
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_admin_secret

AUTH_DB_NAME=securecloud_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_dev_db_secret

FILES_DB_NAME=securecloud_files
FILES_DB_USER=files_user
FILES_DB_PASSWORD=files_dev_db_secret

# ==============================================================================
# ScyllaDB 6.0 Development Configuration
# ==============================================================================
SCYLLA_HOST_PORT=9042
SCYLLA_CLUSTER_NAME=securecloud-dev-cluster
MESSAGING_SCYLLA_KEYSPACE=securecloud_messaging

# ==============================================================================
# ClickHouse 24.8 Development Configuration
# ==============================================================================
CLICKHOUSE_HOST_HTTP_PORT=8123
CLICKHOUSE_HOST_NATIVE_PORT=9009
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=clickhouse_dev_admin_secret

AUDIT_DB_NAME=securecloud_audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=audit_dev_db_secret

# ==============================================================================
# MinIO S3 Object Storage Development Configuration
# ==============================================================================
MINIO_HOST_PORT=9000
MINIO_HOST_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_secret

FILES_MINIO_BUCKET=securecloud-files-encrypted
FILES_MINIO_USER=files_minio_user
FILES_MINIO_PASSWORD=files_dev_minio_secret
