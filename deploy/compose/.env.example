# SecureCloud Development Environment Configuration Template
# DO NOT commit active .env or production credentials to version control.
# Copy this file to deploy/compose/.env for local development customization.

# ==============================================================================
# PostgreSQL 17 Development Configuration
# ==============================================================================
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_admin_secret

AUTH_DB_NAME=securecloud_auth
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_dev_db_secret

FILES_DB_NAME=securecloud_files
FILES_DB_USER=files_user
FILES_DB_PASSWORD=files_dev_db_secret

# ==============================================================================
# ScyllaDB 6.0 Development Configuration
# ==============================================================================
SCYLLA_HOST_PORT=9042
SCYLLA_CLUSTER_NAME=securecloud-dev-cluster

# ==============================================================================
# ClickHouse 24.8 Development Configuration
# ==============================================================================
CLICKHOUSE_HOST_HTTP_PORT=8123
CLICKHOUSE_HOST_NATIVE_PORT=9009
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=clickhouse_dev_admin_secret

AUDIT_DB_NAME=securecloud_audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=audit_dev_db_secret

# ==============================================================================
# MinIO S3 Object Storage Development Configuration
# ==============================================================================
MINIO_HOST_PORT=9000
MINIO_HOST_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_secret

FILES_MINIO_BUCKET=securecloud-files-encrypted
FILES_MINIO_USER=files_minio_user
FILES_MINIO_PASSWORD=files_dev_minio_secret
